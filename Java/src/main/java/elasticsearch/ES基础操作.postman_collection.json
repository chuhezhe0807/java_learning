							"raw": "{\r\n    \"query\": {\r\n        \"bool\": {\r\n            \"must\": [ // 条件 且 &&\r\n                {\r\n                    \"match\": {\r\n                        \"category\": \"小米\"\r\n                    }\r\n                },\r\n                {\r\n                    \"match\": {\r\n                        \"price\": 3999.00\r\n                    }\r\n                }\r\n            ]\r\n        }\r\n    }\r\n}",
